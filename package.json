{
  "name": "estimation-room",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:visual": "playwright test",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "dev:lan": "EXPOSE=1 vite --host",
