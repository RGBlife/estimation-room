# Staging Firebase project — a second, throwaway project in the same Firebase
# account as production. Used to test multi-client features (GTA Mode's
# position streaming, presence, disconnects) against a real backend with real
# network latency, without writing into the database that serves live users.
#
# Setup, once:
#   1. Firebase console → Add project → name it "scrum-poker-staging"
#      (any name works; this file only cares about the values below).
#      Google Analytics is not needed.
#   2. In the new project, enable:
#        - Firestore Database        (start in production mode)
#        - Realtime Database         (note its URL for the last var)
#        - Authentication → Sign-in method → Anonymous
#   3. Add a Web app (</> icon) → copy its config values into the vars below.
#   4. Publish the rules to it once, from this repo's checked-in files:
#        firestore.rules      → Firestore → Rules tab
#        database.rules.json  → Realtime Database → Rules tab
#   5. Copy this file to `.env.staging.local` and fill in the real values.
#      That filename is gitignored, so nothing secret is committed.
#
# Then run:  npm run dev:staging
#
# Staying on the free Spark plan for this second project keeps it free; it has
# its own separate quota, so hammering it never eats production's.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=

# Required. Vite still loads `.env` in staging mode, so without this explicit
# marker a missing/incomplete `.env.staging.local` would silently fall back to
# the PRODUCTION project while looking like staging. The app refuses to start
# in staging mode unless this is set.
VITE_STAGING=1
