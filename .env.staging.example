# Choose a provider for staging. The default is dotnet.
VITE_ROOM_BACKEND=dotnet
VITE_API_URL=

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=

# Required. Vite still loads `.env` in staging mode, so without this explicit
# marker a missing/incomplete `.env.staging.local` would silently fall back to
# the PRODUCTION project while looking like staging. The app refuses to start
# in staging mode unless this is set.
VITE_STAGING=1
