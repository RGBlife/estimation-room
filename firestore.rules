rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function existingData() {
      return resource.data;
    }

    function incomingData() {
      return request.resource.data;
    }

    // Keys of the participants map that changed between old and new document.
    function changedParticipantKeys() {
      return existingData().participants.diff(incomingData().participants).affectedKeys();
    }

    // Key-set checks come before any field access: reading a missing field
    // errors out the whole condition rather than evaluating false.
    function validAvatar(a) {
      return a is map
        && (
          // Current format: full customize-panel avatar (avatar.js AVATAR_CATEGORIES).
          (a.keys().hasAll([
              'seed', 'bgIdx', 'hairIdx', 'hairColorIdx', 'skinColorIdx',
              'eyesIdx', 'eyebrowsIdx', 'mouthIdx',
              'glassesIdx', 'glassesIdxOn', 'earringsIdx', 'earringsIdxOn',
              'featureIdx', 'featureIdxOn',
            ])
            && a.keys().hasOnly([
              'seed', 'bgIdx', 'hairIdx', 'hairColorIdx', 'skinColorIdx',
              'eyesIdx', 'eyebrowsIdx', 'mouthIdx',
              'glassesIdx', 'glassesIdxOn', 'earringsIdx', 'earringsIdxOn',
              'featureIdx', 'featureIdxOn',
            ])
            && a.seed is string && a.seed.size() <= 32
            && a.bgIdx is int && a.bgIdx >= 0 && a.bgIdx < 8
            && a.hairIdx is int && a.hairIdx >= 0 && a.hairIdx < 45
            && a.hairColorIdx is int && a.hairColorIdx >= 0 && a.hairColorIdx < 14
            && a.skinColorIdx is int && a.skinColorIdx >= 0 && a.skinColorIdx < 4
            && a.eyesIdx is int && a.eyesIdx >= 0 && a.eyesIdx < 26
            && a.eyebrowsIdx is int && a.eyebrowsIdx >= 0 && a.eyebrowsIdx < 15
            && a.mouthIdx is int && a.mouthIdx >= 0 && a.mouthIdx < 30
            && a.glassesIdx is int && a.glassesIdx >= 0 && a.glassesIdx < 5
            && a.glassesIdxOn is bool
            && a.earringsIdx is int && a.earringsIdx >= 0 && a.earringsIdx < 6
            && a.earringsIdxOn is bool
            && a.featureIdx is int && a.featureIdx >= 0 && a.featureIdx < 4
            && a.featureIdxOn is bool)
          ||
          // Legacy format: pre-customization-panel avatars (random look only).
          (a.keys().hasAll(['seed', 'bgIdx', 'glasses', 'earrings', 'flair'])
            && a.keys().hasOnly(['seed', 'bgIdx', 'glasses', 'earrings', 'flair'])
            && a.seed is string && a.seed.size() <= 32
            && a.bgIdx is int && a.bgIdx >= 0 && a.bgIdx < 8
            && a.glasses is bool && a.earrings is bool && a.flair is bool)
        );
    }

    // Keep this in sync with src/types/room.ts (Participant, AvatarOptions,
    // LegacyAvatarOptions, CardValue) -- that file documents what this
    // function accepts, it does not enforce it.
    function validParticipant(p) {
      return p is map
        && (
          // Current format: avatar options rendered locally by the client.
          (p.keys().hasAll(['name', 'avatar', 'isObserver', 'vote', 'joinedAt'])
            && p.keys().hasOnly(['name', 'avatar', 'isObserver', 'vote', 'joinedAt'])
            && validAvatar(p.avatar))
          ||
          // Transitional: participants written by pre-local-avatar builds store
          // a dicebear API URL. Removable once no such clients/rooms remain.
          (p.keys().hasAll(['name', 'avatarUrl', 'isObserver', 'vote', 'joinedAt'])
            && p.keys().hasOnly(['name', 'avatarUrl', 'isObserver', 'vote', 'joinedAt'])
            && p.avatarUrl is string
            && p.avatarUrl.size() <= 300
            && p.avatarUrl.matches('https://api[.]dicebear[.]com/.*'))
        )
        && p.name is string && p.name.size() >= 1 && p.name.size() <= 40
        && p.isObserver is bool
        && p.joinedAt is number
        && (p.vote == null || (p.vote is string && p.vote.size() <= 40));
    }

    // Missing is valid for old rooms. Empty or padded strings must be
    // normalized by the client before writing; clearing deletes the field.
    function validTeamName() {
      return !('teamName' in incomingData()) || (
        incomingData().teamName is string
        && incomingData().teamName.size() >= 1
        && incomingData().teamName.size() <= 40
        && incomingData().teamName == incomingData().teamName.trim()
      );
    }

    function validPlanningText(value, max) {
      return value is string && value.size() > 0 && value.size() <= max && value == value.trim();
    }

    function validCriterion(item) {
      let label = item.text;
      return item is map && item.keys().hasOnly(['text', 'checked'])
        && label is string && label.size() > 0 && label.size() <= 160
        && label == label.trim() && item.checked is bool;
    }

    // Validate the bounded map in one pass. Bind values once and check all
    // IDs together to leave enough rule budget for a ticket + round reset.
    function validReadiness(items) {
      let values = items.values();
      let count = values.size();
      let ids = items.keys().join(',');
      return items is map && count <= 12
        && (count == 0 || (ids.matches('[a-zA-Z0-9_-]{1,48}(,[a-zA-Z0-9_-]{1,48}){0,11}')
          && ids.split(',').size() == count))
        && (count <= 0 || validCriterion(values[0]))
        && (count <= 1 || validCriterion(values[1]))
        && (count <= 2 || validCriterion(values[2]))
        && (count <= 3 || validCriterion(values[3]))
        && (count <= 4 || validCriterion(values[4]))
        && (count <= 5 || validCriterion(values[5]))
        && (count <= 6 || validCriterion(values[6]))
        && (count <= 7 || validCriterion(values[7]))
        && (count <= 8 || validCriterion(values[8]))
        && (count <= 9 || validCriterion(values[9]))
        && (count <= 10 || validCriterion(values[10]))
        && (count <= 11 || validCriterion(values[11]))
      ;
    }

    // A selection names a ticket in this room's backlog. The legacy snapshot
    // (activeTicket) can only be kept as it was or cleared.
    function validSelection(roomCode, before, after) {
      return (!('activeTicketId' in after) || (
          after.activeTicketId is string && after.activeTicketId.matches('[a-zA-Z0-9_-]{1,48}')
          && exists(/databases/$(database)/documents/rooms/$(roomCode)/tickets/$(after.activeTicketId))))
        && (!('activeTicket' in after) || after.activeTicket == before.get('activeTicket', null));
    }

    function validPlanningUpdate(roomCode) {
      let before = resource.data;
      let after = request.resource.data;
      let changed = after.diff(before).affectedKeys();
      // Checked first so ordinary votes and joins, which this rule never
      // allows, stop here instead of spending the shared expression budget.
      return changed.hasAny(['readiness', 'activeTicket', 'activeTicketId'])
        && request.auth.uid in before.participants
        && changed.hasOnly(['readiness', 'activeTicket', 'activeTicketId', 'isRevealed', 'participants'])
        && (changed.hasOnly(['readiness']) || (
          request.auth.uid == before.creatorId
          && after.isRevealed == false
          && after.participants.keys().toSet() == before.participants.keys().toSet()
          && validSelection(roomCode, before, after)
        ))
        // Validate once after the authorization branches, including when the
        // same write both selects a ticket and resets a full checklist.
        && validReadiness(after.readiness);
    }

    // -- Backlog tickets: rooms/{code}/tickets/{id}. Mirrors backlog.ts.

    function optionalText(t, field, max) {
      return !(field in t) || validPlanningText(t[field], max);
    }

    // Any author a valid write could have recorded.
    function storedAuthor(a) {
      return a is map && a.keys().hasAll(['uid', 'name', 'at']) && a.keys().hasOnly(['uid', 'name', 'at'])
        && a.uid is string && a.uid.size() <= 128
        && a.name is string && a.name.size() >= 1 && a.name.size() <= 40
        && a.at is int;
    }

    // The author of this write: the caller, under their name in the room, now.
    function validAuthor(a, room) {
      return storedAuthor(a)
        && a.uid == request.auth.uid
        && a.name == room.participants[request.auth.uid].name
        && a.at > request.time.toMillis() - 300000 && a.at < request.time.toMillis() + 300000;
    }

    function validHighlight(h, length) {
      return h is map && h.keys().hasAll(['id', 'start', 'end', 'by']) && h.keys().hasOnly(['id', 'start', 'end', 'by'])
        && h.id is string && h.id.matches('[a-zA-Z0-9_-]{1,48}')
        && h.start is int && h.end is int && h.start >= 0 && h.end > h.start && h.end <= length
        && storedAuthor(h.by);
    }

    function validHighlights(t) {
      let hs = t.get('highlights', []);
      let n = hs.size();
      let length = t.get('description', '').size();
      return hs is list && n <= 12
        && (n <= 0 || validHighlight(hs[0], length))
        && (n <= 1 || validHighlight(hs[1], length))
        && (n <= 2 || validHighlight(hs[2], length))
        && (n <= 3 || validHighlight(hs[3], length))
        && (n <= 4 || validHighlight(hs[4], length))
        && (n <= 5 || validHighlight(hs[5], length))
        && (n <= 6 || validHighlight(hs[6], length))
        && (n <= 7 || validHighlight(hs[7], length))
        && (n <= 8 || validHighlight(hs[8], length))
        && (n <= 9 || validHighlight(hs[9], length))
        && (n <= 10 || validHighlight(hs[10], length))
        && (n <= 11 || validHighlight(hs[11], length));
    }

    function validBacklogTicket(t) {
      return t.keys().hasAll(['title', 'position', 'added'])
        && t.keys().hasOnly(['key', 'title', 'description', 'status', 'position', 'added', 'edited', 'highlights', 'estimate'])
        && validPlanningText(t.title, 200)
        && optionalText(t, 'key', 40)
        && optionalText(t, 'description', 2000)
        && optionalText(t, 'status', 40)
        && t.position is int && t.position >= 0 && t.position <= 1000000
        && storedAuthor(t.added)
        && (!('edited' in t) || (t.edited is map && t.edited.keys().hasOnly(['key', 'title', 'description'])))
        && (!('estimate' in t) || (t.estimate is map && t.estimate.keys().hasOnly(['value', 'at'])
          && validPlanningText(t.estimate.value, 40) && t.estimate.at is int))
        && validHighlights(t);
    }

    // The reveal records the agreed estimate on the ticket at the table, in
    // the same batch that reveals the room.
    function validEstimate(roomCode, ticketId) {
      let room = getAfter(/databases/$(database)/documents/rooms/$(roomCode)).data;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estimate'])
        && room.isRevealed == true && room.get('activeTicketId', '') == ticketId
        && request.resource.data.estimate.at > request.time.toMillis() - 300000
        && request.resource.data.estimate.at < request.time.toMillis() + 300000;
    }

    // An edit changes text fields and records the caller as their editor,
    // moving or dropping highlights with the description. A highlight change
    // adds exactly one, by the caller, or removes exactly one.
    function validTicketUpdate(room) {
      let before = resource.data;
      let after = request.resource.data;
      let changed = after.diff(before).affectedKeys();
      let fields = changed.intersection(['key', 'title', 'description'].toSet());
      let editors = after.get('edited', {}).diff(before.get('edited', {})).affectedKeys();
      let was = before.get('highlights', []);
      let now = after.get('highlights', []);
      let added = now.removeAll(was);
      return changed.hasOnly(['key', 'title', 'description', 'edited', 'highlights'])
        // Editors change exactly with their fields: an old entry cannot
        // vouch for a new edit.
        && editors == fields
        && (!changed.hasAny(['key']) || validAuthor(after.edited.key, room))
        && (!changed.hasAny(['title']) || validAuthor(after.edited.title, room))
        && (!changed.hasAny(['description']) || validAuthor(after.edited.description, room))
        && (!changed.hasAny(['highlights']) || changed.hasAny(['description'])
          || (now.size() == was.size() + 1 && now.hasAll(was) && added.size() == 1 && validAuthor(added[0].by, room))
          || (now.size() == was.size() - 1 && was.hasAll(now)));
    }

    function myIncomingParticipant() {
      return incomingData().participants[request.auth.uid];
    }

    match /rooms/{roomCode} {

      allow get: if true;
      allow list: if false;

      allow create: if isSignedIn()
        && validTeamName()
        && !incomingData().keys().hasAny(['readiness', 'activeTicket', 'activeTicketId'])
        && incomingData().code == roomCode
        && incomingData().isRevealed == false
        && incomingData().creatorId == request.auth.uid
        && incomingData().deck in ['fibonacci', 'tshirt', 'powersOf2', 'rom', 'custom']
        && incomingData().participants.size() == 1
        && incomingData().participants.keys()[0] == request.auth.uid
        && validParticipant(myIncomingParticipant());

      // Readiness is shared by participants; a ticket selection belongs to
      // the creator and atomically starts a new round. Neither can rename a
      // room, transfer ownership, or change its deck.
      allow update: if isSignedIn() && validPlanningUpdate(roomCode);

      // Keep planning fields out of all existing join/vote/leave paths.
      allow update: if isSignedIn()
        && !incomingData().diff(existingData()).affectedKeys().hasAny(['readiness', 'activeTicket', 'activeTicketId']) && (
        // Naming is independent of votes and cannot transfer ownership.
        (request.auth.uid == existingData().creatorId
          && incomingData().diff(existingData()).affectedKeys().hasOnly(['teamName'])
          && validTeamName())
        ||
        // All ordinary updates preserve both the value and absence of the
        // name. Check once outside the branches to stay within the rules budget.
        (incomingData().get('teamName', '') == existingData().get('teamName', '')
          && incomingData().keys().hasAny(['teamName']) == existingData().keys().hasAny(['teamName'])
          && (
        // A participant joining: adds exactly their own key, nothing else changes.
        (
          changedParticipantKeys().hasOnly([request.auth.uid])
          && !(request.auth.uid in existingData().participants)
          && request.auth.uid in incomingData().participants
          && validParticipant(myIncomingParticipant())
          && incomingData().code == existingData().code
          && incomingData().creatorId == existingData().creatorId
          && incomingData().isRevealed == existingData().isRevealed
          && incomingData().deck == existingData().deck
        )
        ||
        // A participant updating only their own participant entry (role/vote).
        (
          request.auth.uid in existingData().participants
          && changedParticipantKeys().hasOnly([request.auth.uid])
          && request.auth.uid in incomingData().participants
          && validParticipant(myIncomingParticipant())
          && incomingData().code == existingData().code
          && incomingData().creatorId == existingData().creatorId
          && incomingData().isRevealed == existingData().isRevealed
          && incomingData().deck == existingData().deck
        )
        ||
        // A participant leaving: removes exactly their own key, nothing else changes.
        (
          request.auth.uid in existingData().participants
          && !(request.auth.uid in incomingData().participants)
          && changedParticipantKeys().hasOnly([request.auth.uid])
          && incomingData().code == existingData().code
          && incomingData().creatorId == existingData().creatorId
          && incomingData().isRevealed == existingData().isRevealed
          && incomingData().deck == existingData().deck
        )
        ||
        // Any current participant removing exactly one OTHER participant's key
        // (disconnect cleanup, driven by Realtime Database presence). Limited to
        // a single-key removal per write, and it must not be the caller's own key
        // (that case is covered by the "leaving" branch above); cannot touch
        // any other field.
        (
          request.auth.uid in existingData().participants
          && changedParticipantKeys().size() == 1
          && !changedParticipantKeys().hasAny([request.auth.uid])
          && incomingData().participants.size() == existingData().participants.size() - 1
          && incomingData().code == existingData().code
          && incomingData().creatorId == existingData().creatorId
          && incomingData().isRevealed == existingData().isRevealed
          && incomingData().deck == existingData().deck
        )
        ||
        // Any current participant revealing votes. The "at least one vote cast"
        // requirement is enforced client-side (Reveal button is disabled otherwise);
        // rules have no iteration/filter construct to check this over an arbitrary-size map.
        (
          request.auth.uid in existingData().participants
          && existingData().isRevealed == false
          && incomingData().isRevealed == true
          && incomingData().diff(existingData()).affectedKeys().hasOnly(['isRevealed'])
        )
        ||
        // Any current participant starting the next round: clears votes, unreveals.
        (
          request.auth.uid in existingData().participants
          && existingData().isRevealed == true
          && incomingData().code == existingData().code
          && incomingData().creatorId == existingData().creatorId
          && incomingData().diff(existingData()).affectedKeys().hasOnly(['participants', 'isRevealed'])
          && incomingData().isRevealed == false
          && incomingData().participants.keys().toSet() == existingData().participants.keys().toSet()
          && incomingData().deck == existingData().deck
        )
        ||
        // The creator switching the estimation deck: changes `deck` and clears
        // every participant's vote in the same write. Rules can't itemize a
        // diff across a map's per-key subfields, so -- mirroring how the
        // start-next-round branch above already handles "every participant's
        // vote field changes in one write" -- this constrains the
        // participants map only by key-set equality (nobody joined/left),
        // trusting the write shape the same way that branch already does.
        (
          request.auth.uid == existingData().creatorId
          && incomingData().deck != existingData().deck
          && incomingData().deck in ['fibonacci', 'tshirt', 'powersOf2', 'rom', 'custom']
          && incomingData().code == existingData().code
          && incomingData().creatorId == existingData().creatorId
          // A deck switch clears every vote, so it also starts a fresh round:
          // leaving the room revealed would show an empty results panel.
          // Only ever false after this write -- it can't be used to reveal.
          && incomingData().isRevealed == false
          && incomingData().participants.keys().toSet() == existingData().participants.keys().toSet()
        )
        ))
      );

      // Leaving keeps the room (an empty room stays joinable), so the app
      // itself never deletes one. Kept for cleaning up: a participant can
      // close their room, and anyone signed in can remove an empty one.
      allow delete: if isSignedIn() && (
        request.auth.uid in existingData().participants
        || existingData().participants.size() == 0
      );

      // The backlog is for the people at the table only: unlike the room
      // document, a room code alone does not reveal it. Leaving the room
      // ends access. Deleted with the room by the expiry job.
      match /tickets/{ticketId} {
        function room() {
          return get(/databases/$(database)/documents/rooms/$(roomCode)).data;
        }
        function isMember() {
          return isSignedIn() && request.auth.uid in room().participants;
        }
        allow get, list: if isMember();
        allow create: if isMember()
          && ticketId.matches('[a-zA-Z0-9_-]{1,48}')
          && validBacklogTicket(incomingData())
          && validAuthor(incomingData().added, room())
          && !incomingData().keys().hasAny(['edited', 'highlights']);
        allow update: if isMember()
          && validBacklogTicket(incomingData())
          && (validTicketUpdate(room()) || validEstimate(roomCode, ticketId));
        // getAfter: clearing the backlog drops the selection in the same batch.
        allow delete: if isMember()
          && getAfter(/databases/$(database)/documents/rooms/$(roomCode)).data.get('activeTicketId', '') != ticketId;
      }
    }
  }
}
