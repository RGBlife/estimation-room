# Selected at build time; changing this requires restarting Vite or rebuilding.
VITE_ROOM_BACKEND=dotnet
# Leave empty for the same origin; Vite proxies /api during local development.
VITE_API_URL=

# Only used when VITE_ROOM_BACKEND=firebase.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=
