{
  "rules": {
    "presence": {
      "$roomCode": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
